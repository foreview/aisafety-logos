{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "title": "AI Safety Logos Index",
  "description": "Index of AI safety organization logos and their variants",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^https?://": {
      "$ref": "#/$defs/organization"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "organization": {
      "type": "object",
      "properties": {
        "canonicalName": {
          "type": "string",
          "description": "The canonical/official name of the organization"
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Alternative names or aliases for the organization"
        },
        "canonical": {
          "type": "string",
          "description": "Key of the default/primary variant in variants object"
        },
        "variants": {
          "type": "object",
          "description": "Logo variants available for the organization",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/logoVariant"
          }
        }
      },
      "required": ["canonicalName", "canonical", "variants"],
      "additionalProperties": false
    },
    "logoVariant": {
      "type": "object",
      "description": "A logo variant with color and white versions",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mark", "wordmark", "lockup"],
          "description": "Logo composition: mark (symbol only), wordmark (text only), lockup (symbol + text)"
        },
        "color": {
          "$ref": "#/$defs/fileList",
          "description": "Color version files, ordered by fidelity (vector first)"
        },
        "white": {
          "$ref": "#/$defs/fileList",
          "description": "White version files, ordered by fidelity (vector first)"
        }
      },
      "required": ["type", "color", "white"],
      "additionalProperties": false
    },
    "fileList": {
      "type": "array",
      "description": "List of equivalent files in different formats, ordered by fidelity",
      "items": {
        "$ref": "#/$defs/fileEntry"
      },
      "minItems": 1
    },
    "fileEntry": {
      "type": "object",
      "description": "A single file with metadata",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to the file relative to repository root"
        },
        "type": {
          "type": "string",
          "description": "MIME type of the file",
          "enum": ["image/svg+xml", "image/png"]
        },
        "width": {
          "type": "integer",
          "description": "Width in pixels",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "description": "Height in pixels",
          "minimum": 1
        }
      },
      "required": ["file", "type", "width", "height"],
      "additionalProperties": false
    }
  }
}
